* text=auto
*.html text eol=lf
*.js text eol=lf
*.cjs text eol=lf linguist-language=JavaScript
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.webp binary

# Only built distributions are generated; keep authored JS/CJS visible in stats.
/dist/index.html linguist-generated
/index.html linguist-generated
/threathunting-room.html linguist-generated
/docs/index.html linguist-generated
/docs/threathunting-room.html linguist-generated
/src/*.js -linguist-generated linguist-detectable
/src/*.cjs -linguist-generated linguist-detectable
